NODE_ENV=development
PORT=3333
CORS_ORIGINS=http://localhost:5173

# Postgres. Local em dev, Neon (string com -pooler) em producao.
DATABASE_URL=postgresql://raiz:raiz@localhost:5432/raiz?schema=public

# Auth — gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Precisam ser diferentes entre si e ter no minimo 32 caracteres.
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DIAS=30
