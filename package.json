{
  "name": "raiz",
  "version": "0.1.0",
  "private": true,
  "description": "Raiz — sistema de gerenciamento financeiro pessoal e familiar",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
